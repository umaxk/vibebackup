# Скопируйте в .env и отредактируйте.

# Пароль администратора панели (обязательно смените).
VBC_ADMIN_PASSWORD=changeme

# Логин администратора.
VBC_ADMIN_USER=admin

# Ключ API. Можно перечислить несколько через запятую (для ротации).
# Сгенерировать: openssl rand -hex 32   (Windows: в PowerShell см. README)
# Пусто — вход по ключу выключен, API работает по cookie-сессии или Basic.
VBC_API_KEY=

# false — только API: веб-интерфейс не поднимается, все UI-адреса отдают 404,
# а API принимает исключительно ключ (Basic и cookie-сессия не действуют).
# Требует непустого VBC_API_KEY.
VBC_UI_ENABLED=true

# Порт панели на хосте.
VBC_PORT=8787

# Часовой пояс контейнера (влияет на расписания и время в UI).
TZ=Europe/Moscow

# Хранить последних бэкапов по умолчанию (0 — не удалять автоматически).
VBC_DEFAULT_RETENTION=7

# Сколько задач бэкапа выполнять одновременно.
VBC_MAX_CONCURRENT=2

# Таймаут одной задачи.
VBC_JOB_TIMEOUT=2h

# Требовать минимум свободного места на диске бэкапов, МБ.
VBC_MIN_FREE_MB=512

# Окно догоняющих запусков после рестарта, минут (0 — выключено).
VBC_GRACE_MINUTES=60

# Каталог на хосте, который монтируется в /sources/data (только чтение).
# Windows: D:/Data   Linux/macOS: /home/user/data
SOURCE_DIR=./sources
